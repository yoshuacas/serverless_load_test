    {
      "type": "text",
      "id": "legend_text",
      "x": 40, "y": 120,
      "width": 310, "height": 190,
      "text": "Test Scenarios\n\n1. Gradual ramp (smooth scaling)\n2. Sudden spike (burst capacity)\n3. Large payloads (ECPU per KB)\n4. Memory growth (storage scaling)\n5. Hot key (single-shard limits)",
      "originalText": "Test Scenarios\n\n1. Gradual ramp (smooth scaling)\n2. Sudden spike (burst capacity)\n3. Large payloads (ECPU per KB)\n4. Memory growth (storage scaling)\n5. Hot key (single-shard limits)",
